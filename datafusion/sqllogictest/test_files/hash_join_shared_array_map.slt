statement ok
reset datafusion.execution.perfect_hash_join_small_build_threshold;

statement ok
reset datafusion.execution.perfect_hash_join_min_key_density;

statement ok
reset datafusion.optimizer.hash_join_single_partition_threshold;

statement ok
reset datafusion.optimizer.hash_join_single_partition_threshold_rows;

statement ok
reset datafusion.execution.target_partitions;

statement ok
DROP TABLE b;

statement ok
DROP TABLE p;
