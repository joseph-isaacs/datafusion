########
# Partitioned join: every build partition builds a Bloom filter sized for the
# whole build, and they merge into one filter that needs no partition routing
# (no `CASE` and no routed `hash_lookup`).
########

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold = 0;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold_rows = 0;

