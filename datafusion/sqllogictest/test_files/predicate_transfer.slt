# Predicate transfer (`datafusion.optimizer.enable_predicate_transfer`): a hash
# join whose build side is too large for an IN list pushes a Bloom filter over
# its build keys (`bloom_filter`) to the probe side instead of a lookup into
# its hash table (`hash_lookup`). Like any join dynamic filter it is
# transferred across equi-join keys, so it reaches the scans of the joins
# below. It is only pushed where the join drops unmatched probe rows.

statement ok
set datafusion.explain.physical_plan_only = true;

statement ok
set datafusion.execution.parquet.pushdown_filters = true;

statement ok
set datafusion.explain.analyze_categories = 'rows';

# Never use an IN list, so even these small build sides use the large-build
# strategy: a hash table lookup, or a Bloom filter with predicate transfer.
statement ok
set datafusion.optimizer.hash_join_inlist_pushdown_max_size = 1;

# ... and a hash table rather than a perfect-hash array over these dense keys.
statement ok
set datafusion.execution.perfect_hash_join_small_build_threshold = 0;

statement ok
COPY (
  SELECT value AS d_key, CASE WHEN value % 10 = 0 THEN 'keep' ELSE 'drop' END AS d_flag
  FROM generate_series(1, 300)
) TO 'test_files/scratch/predicate_transfer/dim.parquet'
STORED AS PARQUET;

statement ok
COPY (
  SELECT value AS m_key, value * 10 AS m_val FROM generate_series(1, 300)
) TO 'test_files/scratch/predicate_transfer/mid.parquet'
STORED AS PARQUET;

statement ok
COPY (
  SELECT value % 300 + 1 AS f_key, value AS f_val FROM generate_series(0, 2999)
) TO 'test_files/scratch/predicate_transfer/fact.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE dim STORED AS PARQUET
LOCATION 'test_files/scratch/predicate_transfer/dim.parquet';

statement ok
CREATE EXTERNAL TABLE mid STORED AS PARQUET
LOCATION 'test_files/scratch/predicate_transfer/mid.parquet';

statement ok
CREATE EXTERNAL TABLE fact STORED AS PARQUET
LOCATION 'test_files/scratch/predicate_transfer/fact.parquet';

########
# Off (the default): the large-build strategy is a hash table lookup.
########

query TT
EXPLAIN ANALYZE SELECT count(*), sum(f_val)
FROM fact JOIN dim ON f_key = d_key WHERE d_flag = 'keep';
----
Plan with Metrics
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*), sum(fact.f_val)@1 as sum(fact.f_val)], metrics=[output_rows=1, output_batches=1]
02)--AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1)), sum(fact.f_val)], metrics=[output_rows=1, output_batches=1]
03)----CoalescePartitionsExec, metrics=[output_rows=4, output_batches=4]
04)------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1)), sum(fact.f_val)], metrics=[output_rows=4, output_batches=4]
