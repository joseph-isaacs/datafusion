########
# Transitive transfer: the `dim` Bloom filter reaches `mid`, the other input of
# the join below, and through `mid.m_key = fact.f_key` the `fact` scan too.
########

query TT
EXPLAIN ANALYZE SELECT count(*), sum(m_val), sum(f_val)
FROM mid JOIN fact ON m_key = f_key JOIN dim ON d_key = m_key
WHERE d_flag = 'keep';
