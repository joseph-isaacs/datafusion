########
# Semi join: the probe side only needs keys with a match, so it is filtered.
########

query II
SELECT count(*), sum(f_val) FROM fact
WHERE f_key IN (SELECT d_key FROM dim WHERE d_flag = 'keep');
----
300 451200

########
# Outer and anti joins must keep unmatched rows of the preserved side, so no
# Bloom filter may be pushed to it.
########

# `fact LEFT JOIN dim` builds `dim` and probes the preserved `fact` side: no
# dynamic filter on the `fact` scan.
query TT
EXPLAIN ANALYZE SELECT count(*), count(d_key), sum(f_val)
FROM fact LEFT JOIN (SELECT d_key FROM dim WHERE d_flag = 'keep') d ON f_key = d_key;
