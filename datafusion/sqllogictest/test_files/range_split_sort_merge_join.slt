DROP TABLE r1;

# Files whose key ranges overlap cannot be split: a plain merge join.
statement ok
COPY (SELECT value AS k, value AS w FROM range(0, 30) ORDER BY k) TO 'test_files/scratch/range_split_sort_merge_join/o/0.parquet';

statement ok
COPY (SELECT value AS k, value AS w FROM range(20, 50) ORDER BY k) TO 'test_files/scratch/range_split_sort_merge_join/o/1.parquet';

statement ok
CREATE EXTERNAL TABLE o (k BIGINT NOT NULL, w BIGINT) STORED AS PARQUET
LOCATION 'test_files/scratch/range_split_sort_merge_join/o/' WITH ORDER (k ASC NULLS LAST);

query TT
EXPLAIN SELECT l.v, o.w FROM l JOIN o ON l.k = o.k
----
logical_plan
01)Projection: l.v, o.w
02)--Inner Join: l.k = o.k
03)----TableScan: l projection=[k, v]
04)----TableScan: o projection=[k, w]
physical_plan
01)SortMergeJoinExec: join_type=Inner, on=[(k@0, k@0)], projection=[v@1, w@3]
02)--SortExec: expr=[k@0 ASC], preserve_partitioning=[true]
03)----RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4
04)------DataSourceExec: file_groups={4 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/2.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/3.parquet]]}, projection=[k, v], output_ordering=[k@0 ASC NULLS LAST], file_type=parquet
05)--SortExec: expr=[k@0 ASC], preserve_partitioning=[true]
06)----RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4
07)------DataSourceExec: file_groups={4 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/o/0.parquet:0..438], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/o/1.parquet:0..443], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/o/1.parquet:443..887], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/o/0.parquet:438..877]]}, projection=[k, w], output_ordering=[k@0 ASC NULLS LAST], file_type=parquet

query I
SELECT count(*) FROM l JOIN o ON l.k = o.k
----
100

# A key column with nulls cannot be split either.
statement ok
COPY (SELECT CASE WHEN value = 0 THEN NULL ELSE value END AS k, value AS w FROM range(0, 10) ORDER BY k NULLS LAST)
TO 'test_files/scratch/range_split_sort_merge_join/n/0.parquet';

statement ok
CREATE EXTERNAL TABLE n (k BIGINT, w BIGINT) STORED AS PARQUET
LOCATION 'test_files/scratch/range_split_sort_merge_join/n/' WITH ORDER (k ASC NULLS LAST);

query TT
EXPLAIN SELECT l.v, n.w FROM l FULL JOIN n ON l.k = n.k
----
logical_plan
01)Projection: l.v, n.w
02)--Full Join: l.k = n.k
03)----TableScan: l projection=[k, v]
04)----TableScan: n projection=[k, w]
physical_plan
01)SortMergeJoinExec: join_type=Full, on=[(k@0, k@0)], projection=[v@1, w@3]
02)--SortExec: expr=[k@0 ASC], preserve_partitioning=[true]
03)----RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4
04)------DataSourceExec: file_groups={4 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/2.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/l/3.parquet]]}, projection=[k, v], output_ordering=[k@0 ASC NULLS LAST], file_type=parquet
05)--SortExec: expr=[k@0 ASC], preserve_partitioning=[true]
06)----RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=1
07)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/range_split_sort_merge_join/n/0.parquet]]}, projection=[k, w], file_type=parquet, sort_order_for_reorder=[k@0 ASC]

query III
SELECT count(*), count(l.k), count(n.k) FROM l FULL JOIN n ON l.k = n.k
----
81 80 18

statement ok
DROP TABLE l;

statement ok
DROP TABLE r;

statement ok
DROP TABLE o;

statement ok
DROP TABLE n;

