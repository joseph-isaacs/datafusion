statement ok
reset datafusion.execution.hash_join_key_packing;

# Partitioned joins pack each build partition relative to its own bounds,
# and route the dynamic filter to each partition's packed map.
statement ok
set datafusion.optimizer.hash_join_single_partition_threshold = 0;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold_rows = 0;

statement ok
set datafusion.execution.target_partitions = 4;

